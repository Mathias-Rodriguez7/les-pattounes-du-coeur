{
	"name": "les-pattounes-du-coeur",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"start": "node build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prisma:generate": "prisma generate",
		"db:generate": "docker compose exec app npx prisma generate && npx prisma generate && docker compose restart app",
		"db:migrate": "docker compose exec app npx prisma migrate dev",
		"db:reset": "docker compose exec app npx prisma migrate reset",
		"db:seed": "docker compose exec app npx tsx prisma/seed.ts",
		"storage:setup": "docker compose exec app npx tsx scripts/setup-storage.ts",
		"db:full-reset": "docker compose down -v && docker compose up --build -d && docker compose exec app npx prisma migrate reset && npm run storage:setup && npm run db:seed && npm run info:import",
		"info:import": "docker compose exec app npx tsx scripts/import-info-documents.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.12.2",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.23.1",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"formsnap": "^2.0.1",
		"globals": "^17.14.0",
		"layerchart": "^2.10.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"prisma": "^7.8.0",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.3.8",
		"vitest": "^4.1.7",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1166.0",
		"@aws-sdk/s3-request-presigner": "^3.1166.0",
		"@faker-js/faker": "^10.4.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"argon2": "^0.44.0",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"mode-watcher": "^1.1.0",
		"node-cron": "^4.6.0",
		"nodemailer": "^10.5.0",
		"pg": "^8.23.1",
		"svelte-charts": "^0.0.1",
		"tailwindcss-animate": "^1.0.7"
	}
}
