POSTGRES_USER=xxxx
POSTGRES_PASSWORD=xxxx
POSTGRES_DB=xxxx

DATABASE_URL=postgresql://xxxx:xxxx@db:PORT/xxxx

SMTP_HOST=xxxx
SMTP_PORT=xxxx
SMTP_USER=xxxx
SMTP_PASS=xxxx
SMTP_FROM=xxxx

# --- Stockage S3 (MinIO en local, R2/Scaleway/AWS en prod) ---
# Adresse utilisée par le SERVEUR pour parler à S3
S3_ENDPOINT=http://s3:9000
# Adresse utilisée pour signer les URLs que le NAVIGATEUR appellera
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=xxxx
S3_SECRET_ACCESS_KEY=xxxx
S3_BUCKET_PUBLIC=pattounes-public
S3_BUCKET_PRIVATE=pattounes-private
# Préfixe des URLs des fichiers publics (lisible par le navigateur)
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/pattounes-public