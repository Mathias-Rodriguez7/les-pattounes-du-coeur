generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////
// Personnes
//////////////////////////

model Profil {
  id            String @id @default(uuid()) @db.Uuid
  firstName     String @map("first_name") @db.VarChar(60)
  lastName      String @map("last_name") @db.VarChar(60)
  birthDate     DateTime? @map("birth_date") @db.Date
  phone         String @unique @db.VarChar(20)
  email         String @db.VarChar(100) @unique
  address       String @db.VarChar(100)
  city          String @default("Montpellier") @db.VarChar(80)
  postalCode    String @default("34000") @map("postal_code") @db.VarChar(10)
  district      District?

  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @default(now()) @updatedAt @map("updatedAt")

  volunteer     Volunteer?
  host          Host?
  blacklists    BlacklistHistoric[]
  adoptions     Adoption[]
}

model Volunteer {
  id                   String @id @default(uuid()) @db.Uuid
  password             String @db.VarChar(255)
  resetToken           String? @map("reset_token") @db.VarChar(255)
  resetTokenExpiresAt  DateTime? @map("reset_token_expiry")
  role                 VolunteerRole
  actif                ColabActivity?
  profilId             String @unique @db.Uuid @map("profil_id")
  profil               Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  isFlexibleDispatcher Boolean @default(false)

  breakStart           DateTime? @map("break_start")
  breakEnd             DateTime? @map("break_end")

  createdAt            DateTime @default(now()) @map("createdAt")
  updatedAt            DateTime @default(now()) @updatedAt @map("updatedAt")

  cats                 CatVolunteer[]
  sessions             Session[]
  assignedForms        Form[] @relation("assignedForms")
}

model Host {
  id                    String @id @default(uuid()) @db.Uuid
  profilId              String @unique @db.Uuid @map("profil_id")
  profil                Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  type                  HostType?
  actif                 ColabActivity?
  catAdult              Int? @map("cat_adult")
  kittyAndKitten        Boolean @default(true)
  kitten                Int?
  isAvailable           Boolean @default(true) @map("is_available")
  additionalInformation String? @db.Text
  hasAnimalsAtHome      Boolean @map("has_animals_at_home")
  numberOfCatsAtHome    Int? @map("number_of_cats_at_home")
  numberOfDogsAtHome    Int? @map("number_of_dogs_at_home")
  otherAnimalsAtHome    String? @map("other_animals_at_home")
  space                 Int
  homeDescription       String @map("home_description") @db.Text
  presence              String @db.VarChar(255)
  outside               Boolean
  outsideDescription    String? @map("outside_description") @db.Text
  isStockFeed           Boolean @map("is_stock_feed")
  heal                  Heal
  socialize             Socialize
  car                   Boolean
  babyFeeding           BabyFeeding @map("baby_feeding")
  stopActivity          String? @db.Text @map("stop_activity")

  breakStart            DateTime? @map("break_start")
  breakEnd              DateTime? @map("break_end")

  createdAt             DateTime @default(now()) @map("createdAt")
  updatedAt             DateTime @default(now()) @updatedAt @map("updatedAt")

  placements            Placement[]
}

model BlacklistHistoric {
  id            String @id @default(uuid()) @db.Uuid
  profilId      String? @db.Uuid @map("profil_id")
  profil        Profil? @relation(fields: [profilId], references: [id], onDelete: SetNull)
  email         String @db.VarChar(255)
  description   String @db.Text
  isBlacklisted Boolean @default(false)
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @default(now()) @updatedAt @map("updatedAt")
}

//////////////////////////
// Chats
//////////////////////////

model Cat {
  id                  String @id @default(uuid()) @db.Uuid
  catNumber           String @unique @db.VarChar(8) @map("cat_number")
  name                String? @db.VarChar(255)
  sex                 SexCat
  birthDate           DateTime? @map("birth_date") @db.Date
  isVisible           Boolean @default(false) @map("is_visible")
  status              CatStatus
  hairLength          HairLength? @map("hair_length")
  color               String? @db.VarChar(255)
  origin              String? @db.VarChar(255)
  isSterilize         Boolean @default(false) @map("is_sterilize")
  isAlreadySterilized Boolean @default(false) @map("is_already_sterilized")
  vaccinate           Vaccinate?
  isFivTest           Boolean @default(false) @map("is_fiv_test")
  isDeworming         Boolean @default(false) @map("is_deworming")
  description         String? @db.Text
  isOkCat             Boolean? @default(false) @map("is_ok_cat")
  isOkDog             Boolean? @default(false) @map("is_ok_dog")
  isOkChild           Boolean? @default(false) @map("is_ok_child")
  isOutside           Boolean? @default(false) @map("is_outside")
  isIdentify          Boolean @default(false) @map("is_identify")
  chipId              String? @unique @db.VarChar(255) @map("chip_id")

  createdAt           DateTime @default(now()) @map("createdAt")
  updatedAt           DateTime @default(now()) @updatedAt @map("updatedAt")

  sicknesses          Sickness[]
  media               MediaCat[]
  documents           CatDocument[] // 🆕 abandon, contrats, retours…
  volunteers          CatVolunteer[]
  placements          Placement[]
  cares               Care[]
  news                NewsCat[]
  adoptions           Adoption[]
}

// État de santé : ce que le chat A (rempli à la main par la bénévole)
model Sickness {
  id          String @id @default(uuid()) @db.Uuid
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  name        String @db.VarChar(255)
  description String?
  treatment   String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      SicknessStatus @default(ACTIVE)

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  cares       Care[] // 🆕 soins liés à cette maladie

  @@index([catId])
}

// Acte vétérinaire : ce que le véto a FAIT, à une date donnée
model Care {
  id          String @id @default(uuid()) @db.Uuid
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id])
  type        CareType
  date        DateTime @db.Date // 🆕 date de l'acte (≠ createdAt = date de saisie)
  veterinary  String? @db.VarChar(255)
  description String? @db.Text
  reason      String @db.Text

  // 🆕 maladie concernée (facultatif : un vaccin n'en a pas)
  sicknessId  String? @db.Uuid @map("sickness_id")
  sickness    Sickness? @relation(fields: [sicknessId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedAt")

  documents   CareDocument[] // 🆕 ordonnance, facture, résultats…

  @@index([catId])
  @@index([sicknessId])
}

//////////////////////////
// Médias & documents
//////////////////////////

// 🆕 Le FICHIER stocké sur S3. Son rôle est décrit par la table qui pointe dessus.
model Media {
  id           String    @id @default(uuid()) @db.Uuid
  type         MediaType
  storageKey   String    @unique @map("storage_key") @db.Text // ex : private/cats/<catId>/<uuid>.pdf
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  originalName String?   @map("original_name") @db.VarChar(255)
  isPrivate    Boolean   @default(false) @map("is_private") // true → URL signée obligatoire

  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @updatedAt @map("updatedAt")

  // Relations inverses (une seule sera remplie pour un fichier donné)
  catGallery   MediaCat?
  news         News?
  catDocument  CatDocument?
  careDocument CareDocument?
}

// Galerie photo/vidéo du chat (migration vers Media : plus tard)
model MediaCat {
  id          String   @id @default(uuid()) @db.Uuid
  catId       String   @db.Uuid @map("cat_id")
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)

  fileId      String   @unique @db.Uuid @map("file_id")
  file        Media    @relation(fields: [fileId], references: [id])

  isPrimary   Boolean  @default(false) @map("is_primary")

  // Point focal en pourcentage (0 à 100), utilisé pour object-position
  focalPointX Float    @default(50) @map("focal_point_x")
  focalPointY Float    @default(50) @map("focal_point_y")

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@index([catId])
}

// 🆕 Documents administratifs / légaux d'un chat (toujours privés)
model CatDocument {
  id         String          @id @default(uuid()) @db.Uuid
  catId      String          @db.Uuid @map("cat_id")
  cat        Cat             @relation(fields: [catId], references: [id], onDelete: Cascade)
  mediaId    String          @unique @db.Uuid @map("media_id")
  media      Media           @relation(fields: [mediaId], references: [id])

  kind       CatDocumentKind
  date       DateTime        @db.Date // date de l'acte (abandon, signature…)
  note       String?         @db.Text

  // Si le document concerne une adoption précise (contrat, retour)
  adoptionId String?         @db.Uuid @map("adoption_id")
  adoption   Adoption?       @relation(fields: [adoptionId], references: [id], onDelete: SetNull)

  createdAt  DateTime        @default(now()) @map("createdAt")
  updatedAt  DateTime        @updatedAt @map("updatedAt")

  @@index([catId])
  @@index([adoptionId])
}

// 🆕 Documents remis par le véto pour un soin (toujours privés)
model CareDocument {
  id        String   @id @default(uuid()) @db.Uuid
  careId    String   @db.Uuid @map("care_id")
  care      Care     @relation(fields: [careId], references: [id], onDelete: Cascade)
  mediaId   String   @unique @db.Uuid @map("media_id")
  media     Media    @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([careId])
}

//////////////////////////
// News
//////////////////////////

model News {
  id        String @id @default(uuid()) @db.Uuid
  title     String @db.VarChar(255)
  type      NewsType
  content   String? @db.Text

  // ⚠️ Ancien champ : à supprimer une fois les news existantes passées sur mediaId
  mediaUrl  String? @map("media_url") @db.Text

  // 🆕 Un seul PDF par news
  mediaId   String? @unique @db.Uuid @map("media_id")
  media     Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  cats      NewsCat[]
}

model NewsCat {
  newsId    String @db.Uuid @map("news_id")
  news      News @relation(fields: [newsId], references: [id])
  catId     String @db.Uuid @map("cat_id")
  cat       Cat @relation(fields: [catId], references: [id])
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  @@id([newsId, catId])
}

//////////////////////////
// Suivi des chats
//////////////////////////

model CatVolunteer {
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id])
  volunteerId String @db.Uuid @map("volunteer_id")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedAt")

  @@id([catId, volunteerId])
}

model Placement {
  id        String @id @default(uuid()) @db.Uuid
  catId     String @db.Uuid @map("cat_id")
  cat       Cat @relation(fields: [catId], references: [id])
  hostId    String @db.Uuid @map("host_id")
  host      Host @relation(fields: [hostId], references: [id])
  status    ColabActivity
  type      PlacementType @default(LONG)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")
}

model Adoption {
  id        String @id @default(uuid()) @db.Uuid
  catId     String @db.Uuid @map("cat_id")
  cat       Cat @relation(fields: [catId], references: [id])

  profilId  String @db.Uuid @map("profil_id")
  profil    Profil @relation(fields: [profilId], references: [id])

  status    AdoptionStatus @default(ACTIVE) // 🆕
  endDate   DateTime? @map("end_date") @db.Date // 🆕 date d'annulation / de retour

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  documents CatDocument[] // 🆕 contrat, retour…

  // 🔁 Plus de @@unique([catId]) : un chat peut être adopté à nouveau après un retour.
  // "Une seule adoption ACTIVE par chat" est vérifié dans la mutation (transaction).
  @@index([catId])
}

//////////////////////////
// Auth & formulaires
//////////////////////////

model Session {
  id          String @id @default(uuid()) @db.Uuid
  token       String @unique @db.VarChar(255)

  volunteerId String @db.Uuid @map("volunteer_id")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  expiresAt   DateTime @map("expires_at")

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedAt")
}

model Form {
  id           String @id @default(uuid()) @db.Uuid
  type         FormType
  status       FormStatus @default(PENDING)
  email        String @db.VarChar(255)
  data         Json @default("{}")

  assignedToId String? @db.Uuid @map("assigned_to_id")
  assignedTo   Volunteer? @relation("assignedForms", fields: [assignedToId], references: [id], onDelete: SetNull)

  notes        String? @db.Text
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @default(now()) @updatedAt @map("updatedAt")

  @@index([type])
  @@index([status])
  @@index([assignedToId])
}

//////////////////////////
// Enums
//////////////////////////

enum District {
  HOPITAUX_FACULTES
  CROIX_D_ARGENT
  PORT_MARIANNE
  CENTRE_VILLE
  CEVENNES
  PRES_D_ARENES
  MOSSON
}

enum ColabActivity {
  ACTIVE
  BREAK
  STOP
}

enum VolunteerRole {
  ADMIN
  MANAGER
  COMMUNICATION
}

enum HostType {
  CLASSIC
  SOS
  ADOPT
  PROPRIO
  RELAY
}

enum Heal {
  NO
  LIGHT
  HEAVY
  HEAVY_STING
}

enum Socialize {
  NO
  FEARFUL
  WITHOUT_EX
  EXPERIENCED
}

enum BabyFeeding {
  NO
  WITHOUT_EX
  EXPERIENCED
  RELAY
}

enum SexCat {
  MALE
  FEMALE
  UNKNOWN
}

enum CatStatus {
  AVAILABLE
  SOCIALIZE
  ADOPTED
  FREE
  DEAD
}

enum HairLength {
  SHORT
  MEDIUM
  LONG
}

enum Vaccinate {
  YES
  NO
  PARTIAL
}

enum CareType {
  VACCINE
  TREATMENT
  SURGERY
  OTHER
  CONTROL
  STERILIZE
  DEWORMING      // 🆕 vermifuge
  FIV_TEST       // 🆕 test FIV/FeLV
  IDENTIFICATION // 🆕 puce
}

enum NewsType {
  NEWS
  NEWSLETTER
  HISTORY
  NEWSCATS
  EVENT
}

enum PlacementType {
  PROPOSAL
  TRANSFER
  LONG
  SHORT
}

enum FormType {
  ADOPTION_SPECIFIC
  ADOPTION_FLEXIBLE
  VOLUNTEER
  HOST
  COLAB
  OTHER // supp
}

enum FormStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SicknessStatus {
  ACTIVE
  TREATED
  RESOLVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// 🆕
enum AdoptionStatus {
  ACTIVE
  CANCELLED
}

// 🆕
enum CatDocumentKind {
  SURRENDER         // abandon / cession à l'association
  ADOPTION_CONTRACT // contrat d'adoption
  ADOPTION_RETURN   // retour / annulation d'adoption
  OTHER
}