  @@index([volunteerId])
}

/// Une tâche mise de côté par UNE personne, jusqu'à une date (« Plus tard »).
/// Les tâches sont calculées : on retient seulement leur identifiant (« C4:<id du chat> »).
/// Elle revient à la date choisie, ou plus tôt si elle est devenue plus urgente.
model TaskSnooze {
  id          String    @id @default(uuid()) @db.Uuid
  volunteerId String    @db.Uuid @map("volunteer_id")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  taskId      String    @map("task_id") @db.VarChar(100)
  until       DateTime
  note        String?   @db.VarChar(255)
  // L'urgence au moment de la mise de côté (URGENT, WEEK, WATCH)
  urgency     String    @db.VarChar(10)
  createdAt   DateTime  @default(now()) @map("createdAt")

  @@unique([volunteerId, taskId])
}

