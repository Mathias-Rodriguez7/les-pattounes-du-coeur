generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////
// Personnes
//////////////////////////

model Profil {
  id            String @id @default(uuid()) @db.Uuid
  firstName     String @map("first_name") @db.VarChar(60)
  lastName      String @map("last_name") @db.VarChar(60)
  birthDate     DateTime? @map("birth_date") @db.Date
  phone         String @unique @db.VarChar(20)
  email         String @db.VarChar(100) @unique
  address       String @db.VarChar(100)
  city          String @default("Montpellier") @db.VarChar(80)
  postalCode    String @default("34000") @map("postal_code") @db.VarChar(10)
  district      District?

  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @default(now()) @updatedAt @map("updatedAt")

  volunteer     Volunteer?
  host          Host?
  blacklists    BlacklistHistoric[]
  adoptions     Adoption[]
  charterAcceptances CharterAcceptance[]
}

model Volunteer {
  id                   String @id @default(uuid()) @db.Uuid
  password             String @db.VarChar(255)
  resetToken           String? @map("reset_token") @db.VarChar(255)
  resetTokenExpiresAt  DateTime? @map("reset_token_expiry")
  role                 VolunteerRole
  actif                ColabActivity?
  profilId             String @unique @db.Uuid @map("profil_id")
  profil               Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)

  breakStart           DateTime? @map("break_start")
  breakEnd             DateTime? @map("break_end")

  createdAt            DateTime @default(now()) @map("createdAt")
  updatedAt            DateTime @default(now()) @updatedAt @map("updatedAt")

  cats                 CatVolunteer[]
  catHistory           CatVolunteerHistory[] // les chats qu'elle a suivis (liens terminés)
  handledSos           Sos[] // les SOS qu'elle a pris en charge
  sessions             Session[]
  assignedForms        Form[] @relation("assignedForms")
  createdInvitations   Invitation[] @relation("createdInvitations")
  taskSnoozes          TaskSnooze[] // les tâches qu'elle a mises de côté (« Plus tard »)
  sosHelps             SosHelper[] // les SOS où elle est en renfort
  formAssignments      FormAssignee[] // les candidatures bénévole / colab qu'elle suit (admin)
  publicationRequests  Cat[] @relation("publicationRequests") // les chats qu'elle a proposés à l'adoption
  // Le récapitulatif de ses tâches, chaque lundi matin (elle peut le désactiver dans son profil)
  weeklyDigest         Boolean @default(true) @map("weekly_digest")
}

model Host {
  id                    String @id @default(uuid()) @db.Uuid
  profilId              String @unique @db.Uuid @map("profil_id")
  profil                Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  type                  HostType?
  actif                 ColabActivity?
  catAdult              Int? @map("cat_adult")
  kittyAndKitten        Boolean @default(true)
  kitten                Int?
  isAvailable           Boolean @default(true) @map("is_available")
  // Depuis quand elle n'est plus disponible (tâche F5 : lui redemander au bout de 3 mois)
  unavailableSince      DateTime? @map("unavailable_since")
  additionalInformation String? @db.Text
  hasAnimalsAtHome      Boolean @map("has_animals_at_home")
  numberOfCatsAtHome    Int? @map("number_of_cats_at_home")
  numberOfDogsAtHome    Int? @map("number_of_dogs_at_home")
  otherAnimalsAtHome    String? @map("other_animals_at_home")
  // Composition du foyer : adultes et enfants (null = pas encore renseignée)
  adultsAtHome          Int? @map("adults_at_home")
  childrenAtHome        Int? @map("children_at_home")
  space                 Int
  homeDescription       String @map("home_description") @db.Text
  presence              String @db.VarChar(255)
  outside               Boolean
  outsideDescription    String? @map("outside_description") @db.Text
  isStockFeed           Boolean @map("is_stock_feed")
  heal                  Heal
  socialize             Socialize
  car                   Boolean
  babyFeeding           BabyFeeding @map("baby_feeding")
  stopActivity          String? @db.Text @map("stop_activity")

  breakStart            DateTime? @map("break_start")
  breakEnd              DateTime? @map("break_end")

  createdAt             DateTime @default(now()) @map("createdAt")
  updatedAt             DateTime @default(now()) @updatedAt @map("updatedAt")

  placements            Placement[]
}

model BlacklistHistoric {
  id            String @id @default(uuid()) @db.Uuid
  profilId      String? @db.Uuid @map("profil_id")
  profil        Profil? @relation(fields: [profilId], references: [id], onDelete: SetNull)
  email         String @db.VarChar(255)
  description   String @db.Text
  isBlacklisted Boolean @default(false)
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @default(now()) @updatedAt @map("updatedAt")
}

//////////////////////////
// Chats
//////////////////////////

model Cat {
  id                  String @id @default(uuid()) @db.Uuid
  // Le N° Pattounes : toujours là pour un chat asso ; un chat libre n'en a que si l'asso
  // a payé sa stérilisation (plusieurs NULL ne gênent pas l'unicité)
  catNumber           String? @unique @db.VarChar(8) @map("cat_number")
  name                String? @db.VarChar(255)
  sex                 SexCat
  birthDate           DateTime? @map("birth_date") @db.Date
  isVisible           Boolean @default(false) @map("is_visible")
  // Date du dernier passage de « masqué » à « visible » : sert aux News chats
  publishedAt         DateTime? @map("published_at")
  status              CatStatus
  hairLength          HairLength? @map("hair_length")
  color               String? @db.VarChar(255)
  origin              String? @db.VarChar(255)
  // Le SOS qui a fait entrer le chat à l'association (s'il y en a un)
  sosId               String? @db.Uuid @map("sos_id")
  sos                 Sos? @relation(fields: [sosId], references: [id], onDelete: SetNull)
  isSterilize         Boolean @default(false) @map("is_sterilize")
  isAlreadySterilized Boolean @default(false) @map("is_already_sterilized")
  vaccinate           Vaccinate?
  isFivTest           Boolean @default(false) @map("is_fiv_test")
  isDeworming         Boolean @default(false) @map("is_deworming")
  description         String? @db.Text
  isOkCat             Boolean? @default(false) @map("is_ok_cat")
  isOkDog             Boolean? @default(false) @map("is_ok_dog")
  isOkChild           Boolean? @default(false) @map("is_ok_child")
  isOutside           Boolean? @default(false) @map("is_outside")
  isIdentify          Boolean @default(false) @map("is_identify")
  chipId              String? @unique @db.VarChar(255) @map("chip_id")
  tattooId            String? @unique @db.VarChar(50) @map("tattoo_id")
  // Chat libre (statut FREE) : attrapé, stérilisé, relâché. Gardé s'il devient un chat asso
  freeInfo            FreeCatInfo?

  // Publication : la bénévole du chat la demande, l'admin ou une COMMUNICATION la valide
  // (le chat devient visible et disponible) ou la refuse avec un mot
  publicationRequestedAt   DateTime? @map("publication_requested_at")
  publicationRequestedById String?   @db.Uuid @map("publication_requested_by_id")
  publicationRequestedBy   Volunteer? @relation("publicationRequests", fields: [publicationRequestedById], references: [id], onDelete: SetNull)
  publicationRefusedAt     DateTime? @map("publication_refused_at")
  publicationRefusalNote   String?   @map("publication_refusal_note") @db.VarChar(500)

  createdAt           DateTime @default(now()) @map("createdAt")
  updatedAt           DateTime @default(now()) @updatedAt @map("updatedAt")

  sicknesses          Sickness[]
  media               MediaCat[]
  documents           CatDocument[] // 🆕 abandon, contrats, retours…
  volunteers          CatVolunteer[]
  volunteerHistory    CatVolunteerHistory[] // les bénévoles qui l'ont suivi (liens terminés)
  placements          Placement[]
  cares               Care[]
  news                NewsCat[]
  adoptions           Adoption[]
  forms               Form[]

  @@index([isVisible, status, publishedAt])
  @@index([sosId])
}

/// Un chat libre : attrapé par une bénévole, stérilisé, puis relâché sur son lieu de vie.
/// La stérilisation elle-même est un soin (Care STERILIZE) ; la gestionnaire, un CatVolunteer.
/// Le contact du nourrisseur : visible seulement par l'admin et la bénévole du chat.
model FreeCatInfo {
  catId      String @id @db.Uuid @map("cat_id")
  cat        Cat    @relation(fields: [catId], references: [id], onDelete: Cascade)

  // Qui paye la stérilisation (« Autre » : le nom dans payerOther)
  payer      SterilizationPayer
  payerOther String? @map("payer_other") @db.VarChar(255)

  // Le lieu de relâchage, comme le lieu d'un SOS
  address    String  @db.VarChar(500)
  city       String  @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(10)
  district   District?
  latitude   Float?
  longitude  Float?

  // Le nourrisseur (ou le contact sur place)
  feederName    String @map("feeder_name") @db.VarChar(255)
  feederContact String @map("feeder_contact") @db.VarChar(255)

  notes      String? @db.Text

  // Passé en chat asso (les infos restent : la carte « Origine : chat libre »)
  convertedAt DateTime? @map("converted_at")

  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @default(now()) @updatedAt @map("updatedAt")
}

enum SterilizationPayer {
  ASSO
  MONTPELLIER
  JUVIGNAC
  LATTES
  SAINT_CLEMENT_DE_RIVIERE
  SAINT_JEAN_DE_VEDAS
  OTHER
}

// État de santé : ce que le chat A (rempli à la main par la bénévole)
model Sickness {
  id          String @id @default(uuid()) @db.Uuid
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  name        String @db.VarChar(255)
  description String?
  treatment   String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      SicknessStatus @default(ACTIVE)

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  cares       Care[] // 🆕 soins liés à cette maladie

  @@index([catId])
}

// Acte vétérinaire : ce que le véto a FAIT, à une date donnée
model Care {
  id          String @id @default(uuid()) @db.Uuid
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id])
  type        CareType
  date        DateTime @db.Date // 🆕 date de l'acte (≠ createdAt = date de saisie)
  veterinary  String? @db.VarChar(255)
  description String? @db.Text
  reason      String @db.Text

  // 🆕 maladie concernée (facultatif : un vaccin n'en a pas)
  sicknessId  String? @db.Uuid @map("sickness_id")
  sickness    Sickness? @relation(fields: [sicknessId], references: [id], onDelete: SetNull)

  // Le vétérinaire de la liste. Absent : « Autre », le nom est alors dans `veterinary`
  // (et les soins saisis avant la liste gardent leur texte)
  veterinarianId String? @db.Uuid @map("veterinarian_id")
  veterinarian   Veterinarian? @relation(fields: [veterinarianId], references: [id], onDelete: SetNull)

  // Vaccin : la date du rappel (tâche V1, 14 jours avant)
  nextDueDate    DateTime? @db.Date @map("next_due_date")

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedAt")

  documents   CareDocument[] // 🆕 ordonnance, facture, résultats…

  @@index([catId])
  @@index([sicknessId])
  @@index([veterinarianId])
}

/// Les vétérinaires de l'association : partenaires, urgences, spécialistes (liste gérée par l'admin)
model Veterinarian {
  id        String @id @default(uuid()) @db.Uuid
  category  VeterinarianCategory @default(PARTNER)
  name      String @db.VarChar(255) // la clinique (ou le cabinet)
  doctors   String? @db.VarChar(255) // « Dr MENARD », « Dr GILLES et Dr COIGNET »
  specialty String? @db.VarChar(255) // « dermatologie », « ophtalmologie »…
  area      String? @db.VarChar(100) // le secteur : « Montpellier / Port Marianne »
  address   String? @db.VarChar(255)
  phone     String? @db.VarChar(30)
  website   String? @db.VarChar(255)
  hours     String? @db.Text
  notes     String? @db.Text
  // Retiré de la liste : il n'est plus proposé, mais les soins passés gardent son nom
  isActive  Boolean @default(true) @map("is_active")
  // Partenaire de la mairie de Montpellier (stérilisation des chats libres)
  isCityPartner Boolean @default(false) @map("is_city_partner")

  cares     Care[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")
}

enum VeterinarianCategory {
  PARTNER    // toutes prises en charge
  EMERGENCY  // urgences (nuit, week-end)
  SPECIALIST // uniquement sur orientation d'un autre vétérinaire
}

//////////////////////////
// Médias & documents
//////////////////////////

// 🆕 Le FICHIER stocké sur S3. Son rôle est décrit par la table qui pointe dessus.
model Media {
  id           String    @id @default(uuid()) @db.Uuid
  type         MediaType
  storageKey   String    @unique @map("storage_key") @db.Text // ex : private/cats/<catId>/<uuid>.pdf
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  originalName String?   @map("original_name") @db.VarChar(255)
  isPrivate    Boolean   @default(false) @map("is_private") // true → URL signée obligatoire

  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @updatedAt @map("updatedAt")

  // Relations inverses (une seule sera remplie pour un fichier donné)
  catGallery   MediaCat?
  news         News?
  catDocument  CatDocument?
  careDocument CareDocument?
  infoDocument InfoDocument?
}

// Galerie photo/vidéo du chat (migration vers Media : plus tard)
model MediaCat {
  id          String   @id @default(uuid()) @db.Uuid
  catId       String   @db.Uuid @map("cat_id")
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)

  fileId      String   @unique @db.Uuid @map("file_id")
  file        Media    @relation(fields: [fileId], references: [id])

  isPrimary   Boolean  @default(false) @map("is_primary")

  // Point focal en pourcentage (0 à 100), utilisé pour object-position
  focalPointX Float    @default(50) @map("focal_point_x")
  focalPointY Float    @default(50) @map("focal_point_y")

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")

  @@index([catId])
}

// 🆕 Documents administratifs / légaux d'un chat (toujours privés)
model CatDocument {
  id         String          @id @default(uuid()) @db.Uuid
  catId      String          @db.Uuid @map("cat_id")
  cat        Cat             @relation(fields: [catId], references: [id], onDelete: Cascade)
  mediaId    String          @unique @db.Uuid @map("media_id")
  media      Media           @relation(fields: [mediaId], references: [id])

  kind       CatDocumentKind
  date       DateTime        @db.Date // date de l'acte (abandon, signature…)
  note       String?         @db.Text

  // Si le document concerne une adoption précise (contrat, retour)
  adoptionId String?         @db.Uuid @map("adoption_id")
  adoption   Adoption?       @relation(fields: [adoptionId], references: [id], onDelete: SetNull)

  createdAt  DateTime        @default(now()) @map("createdAt")
  updatedAt  DateTime        @updatedAt @map("updatedAt")

  @@index([catId])
  @@index([adoptionId])
}

// 🆕 Documents remis par le véto pour un soin (toujours privés)
model CareDocument {
  id        String   @id @default(uuid()) @db.Uuid
  careId    String   @db.Uuid @map("care_id")
  care      Care     @relation(fields: [careId], references: [id], onDelete: Cascade)
  mediaId   String   @unique @db.Uuid @map("media_id")
  media     Media    @relation(fields: [mediaId], references: [id])

  createdAt DateTime @default(now()) @map("createdAt")

  @@index([careId])
}

// Documents d'information pour les bénévoles (guides, modèles…), toujours privés
model InfoDocument {
  id          String               @id @default(uuid()) @db.Uuid
  title       String               @db.VarChar(255)
  description String?              @db.Text
  category    InfoDocumentCategory

  fileId      String               @unique @db.Uuid @map("file_id")
  file        Media                @relation(fields: [fileId], references: [id])

  createdAt   DateTime             @default(now()) @map("createdAt")
  updatedAt   DateTime             @updatedAt @map("updatedAt")

  // Les acceptations de ce document (convention FA, manuel bénévole) : on ne peut plus
  // le supprimer une fois accepté (onDelete: Restrict côté CharterAcceptance)
  acceptances CharterAcceptance[]

  @@index([category])
}

//////////////////////////
// News
//////////////////////////

model News {
  id        String @id @default(uuid()) @db.Uuid
  title     String @db.VarChar(255)
  type      NewsType
  content   String? @db.Text

  // 🆕 Un seul PDF par news
  mediaId   String? @unique @db.Uuid @map("media_id")
  media     Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  cats      NewsCat[]
}

model NewsCat {
  newsId    String @db.Uuid @map("news_id")
  news      News @relation(fields: [newsId], references: [id])
  catId     String @db.Uuid @map("cat_id")
  cat       Cat @relation(fields: [catId], references: [id])
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  @@id([newsId, catId])
}

//////////////////////////
// Suivi des chats
//////////////////////////

model CatVolunteer {
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id])
  volunteerId String @db.Uuid @map("volunteer_id")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedAt")

  @@id([catId, volunteerId])
}

/// Un lien bénévole ↔ chat TERMINÉ (la bénévole a été retirée du chat) : son historique.
/// Les liens en cours restent dans CatVolunteer : rien ne change pour le reste de l'appli.
model CatVolunteerHistory {
  id          String @id @default(uuid()) @db.Uuid
  catId       String @db.Uuid @map("cat_id")
  cat         Cat @relation(fields: [catId], references: [id], onDelete: Cascade)
  volunteerId String @db.Uuid @map("volunteer_id")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  startedAt   DateTime @map("started_at") // la date du lien d'origine (CatVolunteer.createdAt)
  endedAt     DateTime @default(now()) @map("ended_at")

  @@index([volunteerId])
  @@index([catId])
}

model Placement {
  id        String @id @default(uuid()) @db.Uuid
  catId     String @db.Uuid @map("cat_id")
  cat       Cat @relation(fields: [catId], references: [id])
  hostId    String @db.Uuid @map("host_id")
  host      Host @relation(fields: [hostId], references: [id])
  status    ColabActivity
  type      PlacementType @default(LONG)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")
}

model Adoption {
  id        String @id @default(uuid()) @db.Uuid
  catId     String @db.Uuid @map("cat_id")
  cat       Cat @relation(fields: [catId], references: [id])

  profilId  String @db.Uuid @map("profil_id")
  profil    Profil @relation(fields: [profilId], references: [id])

  status      AdoptionStatus @default(TRIAL)
  trialEndsAt DateTime       @map("trial_ends_at") @db.Date
  finalizedAt DateTime?      @map("finalized_at") @db.Date
  endDate     DateTime?      @map("end_date") @db.Date // date d'annulation / de retour
  cancelReason String?     @map("cancel_reason") @db.Text // pourquoi l'adoption a été annulée (facultatif)
  icadTransferredAt DateTime? @map("icad_transferred_at") @db.Date // propriétaire changé sur l'I-CAD (à la finalisation)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @default(now()) @updatedAt @map("updatedAt")

  documents CatDocument[] // 🆕 contrat, retour…

  // 🔁 Plus de @@unique([catId]) : un chat peut être adopté à nouveau après un retour.
  // "Une seule adoption ACTIVE par chat" est vérifié dans la mutation (transaction).
  @@index([catId])
  @@index([status, trialEndsAt])
}

//////////////////////////
// Auth & formulaires
//////////////////////////

model Session {
  id          String @id @default(uuid()) @db.Uuid
  token       String @unique @db.VarChar(255)

  volunteerId String @db.Uuid @map("volunteer_id")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  expiresAt   DateTime @map("expires_at")

  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @default(now()) @updatedAt @map("updatedAt")
}

model Form {
  id           String @id @default(uuid()) @db.Uuid
  type         FormType
  status       FormStatus @default(PENDING)
  email        String @db.VarChar(255)
  data         Json @default("{}")
    // Le chat concerné : demande précise, ou chat choisi pour une demande libre
  catId        String? @db.Uuid @map("cat_id")
  cat          Cat?    @relation(fields: [catId], references: [id], onDelete: SetNull)

  assignedToId String? @db.Uuid @map("assigned_to_id")
  assignedTo   Volunteer? @relation("assignedForms", fields: [assignedToId], references: [id], onDelete: SetNull)

  notes        String? @db.Text
  // Candidatures bénévole et colab : plusieurs admins peuvent les suivre (les autres types
  // gardent une seule personne : assignedTo)
  assignees    FormAssignee[]
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @default(now()) @updatedAt @map("updatedAt")

  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([catId])
}

model Invitation {
  id          String         @id @default(uuid()) @db.Uuid
  kind        InvitationKind
  email       String         @db.VarChar(100)
  /// Les données du formulaire de création, déjà validées (createHostSchema / createVolunteerSchema)
  data        Json
  /// sha256 du jeton envoyé par email : le jeton lui-même n'est jamais stocké
  tokenHash   String         @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime       @map("expires_at")
  /// La demande (formulaire public) à l'origine de la création, s'il y en a une
  formId      String?        @map("form_id") @db.Uuid
  createdById String?        @map("created_by_id") @db.Uuid
  createdBy   Volunteer?     @relation("createdInvitations", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now()) @map("createdAt")

  @@index([kind])
  @@index([email])
}

/// La preuve : telle personne a accepté tel document, à telle date
model CharterAcceptance {
  id         String       @id @default(uuid()) @db.Uuid
  profilId   String       @map("profil_id") @db.Uuid
  profil     Profil       @relation(fields: [profilId], references: [id], onDelete: Cascade)
  documentId String       @map("document_id") @db.Uuid
  document   InfoDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  acceptedAt DateTime     @default(now()) @map("accepted_at")

  @@unique([profilId, documentId])
  @@index([documentId])
}

//////////////////////////
// Enums
//////////////////////////

enum District {
  HOPITAUX_FACULTES
  CROIX_D_ARGENT
  PORT_MARIANNE
  CENTRE_VILLE
  CEVENNES
  PRES_D_ARENES
  MOSSON
}

enum ColabActivity {
  ACTIVE
  BREAK
  STOP
}

enum VolunteerRole {
